, 1893, 264, 810, 9966, 828, 6373, 6425, 369, 279, 6593, 7576, 315, 1202, 6978, 13, 578, 18428, 4729, 374, 26555, 716, 60267, 11, 323, 433, 6276, 6978, 311, 617, 2539, 2585, 315, 2680, 311, 872, 7576, 2085, 8850, 315, 828, 69140, 382, 18, 13, 35138, 10423, 482, 578, 35138, 3109, 706, 8040, 264, 18428, 6108, 2447, 10968, 389, 41577, 323, 18646, 4363, 19989, 2038, 11, 28462, 9966, 323, 11297, 4363, 14463, 369, 2225, 23455, 323, 37249, 382, 3561, 38220, 24686, 82, 271, 3561, 38220, 49125, 1514, 264, 16996, 3560, 304, 68365, 279, 25375, 315, 18428, 5557, 304, 279, 128006, 882, 128007, 271, 6854, 499, 4587, 3493, 810, 11944, 2038, 389, 279, 4907, 15652, 315, 18428, 5557, 323, 1268, 433, 22223, 279, 586, 10706, 596, 5845, 311, 14201, 433, 30, 128006, 78191, 128007, 271, 96556, 13, 578, 4907, 15652, 2631, 311, 1977, 323, 1629, 264, 18428, 4009, 374, 5115, 1579, 11, 15871, 4245, 311, 279, 6485, 90229, 26249, 430, 279, 1887, 5829, 311, 9788, 14463, 13, 2057, 16136, 304, 279, 4009, 10741, 1920, 3967, 439, 11935, 11, 13428, 43243, 323, 39688, 1205, 311, 20874, 449, 1855, 1023, 311, 11886, 6485, 37072, 47623, 311, 17782, 520, 279, 4495, 4320, 13, 1115, 10937, 1920, 60606, 13057, 15055, 315, 4907, 13, 10771, 311, 39069, 1965, 316, 380, 11, 13428, 11935, 7636, 60606, 13489, 220, 4386, 13, 6365, 350, 1671, 30171, 11, 13890, 311, 279, 4907, 15652, 315, 32164, 26, 420, 4907, 15652, 374, 8647, 369, 13489, 220, 1399, 3610, 18767, 20181, 315, 12782, 20748, 30171, 13, 1115, 1579, 4907, 7631, 3727, 279, 5557, 5115, 11646, 311, 14816, 11, 5423, 369, 9333, 586, 10706, 11351, 430, 1253, 539, 617, 279, 5995, 5070, 311, 14201, 433, 13, 24296, 11, 279, 586, 10706, 596, 7347, 11006, 3445, 430, 433, 12580, 11292, 11709, 1990, 4907, 15652, 323, 79010, 13, 23212, 11, 279, 1579, 4907, 15652, 2631, 311, 1629, 279, 18428, 4009, 1436, 4017, 279, 586, 10706, 596, 5845, 311, 4305, 420, 5557, 4028, 1202, 4553, 14054, 13, 1789, 2937, 11, 433, 596, 7701, 97356, 369, 264, 586, 10706, 7471, 311, 8454, 1202, 