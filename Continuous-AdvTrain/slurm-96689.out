3, 18, 2927, 11, 499, 649, 1893, 6485, 323, 21416, 828, 9302, 8200, 13, 220, 18, 13, 13688, 1701, 5234, 37684, 512, 14196, 4077, 322, 6247, 311, 7068, 264, 42415, 3703, 9676, 449, 5234, 37684, 271, 12243, 37684, 31772, 493, 3670, 518, 341, 262, 9676, 25, 341, 286, 955, 25, 364, 2308, 1270, 262, 1173, 262, 2316, 25, 341, 286, 1495, 25, 364, 27414, 3772, 17150, 1270, 262, 1173, 262, 62285, 25, 341, 286, 11306, 25, 2570, 21124, 518, 364, 25904, 518, 364, 50444, 4532, 262, 1173, 262, 63678, 25, 341, 286, 1332, 25, 220, 15, 345, 286, 2316, 25, 341, 310, 1495, 25, 364, 7749, 20392, 1270, 286, 457, 262, 1173, 262, 13314, 25, 341, 286, 28537, 25, 837, 198, 262, 1173, 262, 7234, 3883, 25, 341, 286, 4101, 25, 341, 310, 75172, 25, 364, 8416, 1270, 286, 457, 262, 1173, 262, 4101, 25, 18903, 286, 836, 25, 364, 73147, 756, 286, 828, 25, 510, 20, 11, 220, 18, 11, 220, 20, 933, 262, 2529, 341, 286, 836, 25, 364, 17828, 756, 286, 828, 25, 510, 18, 11, 220, 17, 11, 220, 19, 933, 262, 2529, 341, 286, 836, 25, 364, 74115, 756, 286, 828, 25, 510, 17, 11, 220, 17, 11, 220, 18, 933, 262, 29494, 3033, 14196, 4077, 2028, 2082, 6205, 27983, 264, 42415, 3703, 9676, 449, 5234, 37684, 11, 27393, 3674, 3772, 17150, 4028, 2380, 15771, 13, 5234, 37684, 6209, 264, 2134, 315, 49141, 5110, 1778, 439, 8183, 9382, 11, 8146, 11, 323, 810, 13, 4314, 527, 1120, 264, 2478, 10507, 315, 1268, 311, 1005, 9676, 73277, 20797, 311, 3118, 3674, 3772, 20392, 828, 13, 6104, 279, 2082, 649, 387, 6485, 11, 279, 1121, 374, 3629, 264, 43395, 33352, 323, 39319, 3113, 315, 828, 11, 10923, 3932, 311, 2731, 3619, 872, 3674, 3772, 17150, 13]
