97, 19564, 7119, 2128, 7224, 477, 28271, 11, 18699, 6848, 11, 477, 76579, 315, 18105, 13, 578, 5357, 649, 387, 389, 20632, 323, 2128, 52499, 4856, 1109, 3927, 10937, 13, 220, 18, 13, 423, 8194, 990, 27833, 25, 3142, 18324, 7620, 649, 1101, 387, 30464, 311, 29376, 17226, 990, 27833, 11, 2737, 1884, 449, 2204, 15823, 323, 13042, 35869, 13, 1789, 3187, 11, 1063, 11351, 1253, 10932, 264, 810, 879, 323, 14653, 660, 5603, 311, 18324, 13, 763, 1778, 5157, 11, 279, 2128, 3063, 649, 3708, 35649, 8554, 311, 7931, 477, 7411, 430, 11415, 872, 6928, 19035, 13, 23212, 11, 18324, 12659, 649, 33435, 13042, 32006, 11, 1778, 439, 52913, 4731, 477, 15612, 505, 5370, 13042, 36576, 13, 763, 12399, 11, 586, 18324, 7620, 649, 387, 30464, 311, 2204, 990, 27833, 11, 2737, 8870, 7411, 11, 2536, 12, 93499, 990, 22484, 11, 323, 17226, 27833, 13, 578, 1401, 374, 311, 52056, 279, 2068, 311, 7937, 279, 19882, 323, 3966, 315, 279, 8420, 11, 6968, 264, 5647, 315, 4029, 323, 35996, 430, 20722, 25835, 323, 26206, 13]
