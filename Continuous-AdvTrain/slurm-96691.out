2, 50179, 1473, 12, 1472, 649, 1005, 264, 6651, 315, 2204, 24149, 36680, 311, 923, 810, 17615, 323, 10651, 311, 701, 24149, 42954, 13, 7839, 2671, 2997, 40715, 5192, 13391, 11, 89240, 9259, 11, 323, 12565, 351, 820, 627, 12, 2057, 1304, 264, 38455, 12862, 2373, 315, 279, 24149, 42954, 11, 28779, 279, 682, 59338, 20415, 449, 264, 38455, 12862, 20415, 20955, 477, 63168, 20415, 627, 12, 1442, 499, 1093, 701, 24149, 42954, 311, 617, 264, 810, 42834, 61376, 11, 923, 38525, 31049, 1093, 31100, 598, 11, 41926, 64866, 477, 88922, 627, 12, 14043, 2017, 24149, 42954, 649, 387, 9967, 304, 459, 264, 2154, 492, 5593, 304, 279, 46044, 369, 709, 311, 2380, 2919, 13, 1050, 20559, 304, 279, 24276, 477, 42374, 1603, 13788, 13, 128006, 882, 128007, 271, 6854, 499, 3041, 757, 1063, 18726, 369, 5217, 32523, 430, 358, 649, 923, 311, 279, 24149, 42954, 311, 1304, 433, 810, 7185, 30, 128006, 78191, 128007, 271, 40914, 11, 1618, 527, 1063, 18726, 369, 5217, 32523, 430, 499, 1436, 923, 311, 701, 24149, 42954, 1473, 16, 13, 52310, 81631, 477, 23661, 482, 7999, 264, 2766, 315, 7878, 30564, 81631, 477, 23661, 311, 279, 41776, 690, 3041, 1124, 264, 10107, 11, 60290, 88, 17615, 430, 13840, 1664, 449, 279, 8369, 49659, 304, 279, 1589, 23568, 61376, 13, 220, 17, 13, 68394, 482, 499, 649, 923, 264, 2766, 315, 5015, 44768, 311, 279, 61376, 21655, 369, 264, 8369, 323, 48351, 10536, 13, 220, 18, 13, 44570, 45322, 482, 369, 264, 18406, 4498, 27744, 11, 1456, 32434, 10831, 279, 14198, 13465, 304, 279, 61376, 21655, 449, 55480, 45322, 13, 220, 19, 13, 67530, 36989, 482, 7878, 477, 32720, 70637, 36989, 649, 387, 3779, 311, 279, 24149, 21655, 369, 264, 45915, 323, 93032, 17615, 13, 220, 20, 13, 66682, 8819, 482, 7999, 264, 2766, 315, 33165, 8819, 311, 279, 61376, 21655, 690, 3041, 433, 264, 27545, 64550, 323, 8149, 315, 17615, 13, 220, 21, 13, 6938, 309, 316, 482, 1456, 7999, 220, 16, 14, 19, 42384, 315, 5015, 3786, 309, 316, 311, 279, 61376, 21655, 369, 264, 8369, 11, 9578, 88, 17615, 13, 220, 22, 13, 356, 47704, 19737, 482, 1377, 44237, 1063, 59811, 19737, 927, 279, 1948, 315, 279, 24149, 42954, 3131, 433, 596, 8220, 28915, 369, 264, 88133, 306, 4322, 13, 18231, 1521, 18726, 1520, 323, 6380, 28915, 0, 128006, 882, 128007, 271, 6854, 499, 387, 810, 3230, 922, 279, 2204, 4595, 315, 41776, 430, 358, 1436, 1005, 304, 420, 11363, 30, 358, 1390, 311, 1304, 2771, 358, 3820, 279, 1888, 6305, 369, 279, 2683, 13, 128006, 78191, 128007, 271, 96556, 0, 2684, 527, 1690, 2204, 4595, 315, 41776, 430, 990, 1664, 304, 24149, 42954, 11, 323, 279, 1888, 6305, 690, 6904, 389, 701, 4443, 12945, 323, 10651, 19882, 13, 5810, 527, 1063, 5526, 2671, 1473, 16, 13, 40715, 5192, 13391, 482, 1521, 41776, 527, 3967, 369, 872, 56153, 11, 42954, 10651, 323, 10437, 2442, 472, 17615, 11, 902, 1304, 1124, 264, 2294, 5873, 369, 41778, 11822, 1093, 24149, 42954, 13, 220, 17, 13, 89240, 9259, 482, 1521, 45915, 41776, 527, 1101, 264, 733, 4791, 5873, 369, 28915, 11, 439, 814, 3412, 872, 6211, 1664, 323, 923, 264, 6555, 45915, 2136, 311, 8335, 704, 279, 64550, 315, 279, 61376, 13, 220, 18, 13, 26531, 3141, 399, 482, 1521, 41776, 617, 264, 10284, 48351, 17615, 323, 7626, 10651, 11, 902, 3727, 1124, 264, 1695, 5873, 369, 10168, 872, 6211, 304, 41778, 11822, 13, 220, 19, 13, 12565, 351, 820, 482, 1521, 41776, 527, 264, 5425, 1990, 12565, 24893, 323, 18288, 85788, 11, 323, 617, 264, 6555, 8335, 315, 64550, 323, 45915, 2136, 13, 220, 20, 13, 36775, 1974, 482, 1521, 10284, 45915, 41776, 617, 264, 28682, 10651, 430, 3727, 1124, 264, 1695, 5873, 369, 24149, 42954, 19141, 13, 220, 21, 13, 4656, 13391, 258, 482, 1521, 10437, 41776, 617, 264, 7626, 10651, 430, 10187, 709, 1664, 304, 28915, 13, 5046, 3388, 11, 1521, 527, 1120, 264, 2478, 18726, 482, 2733, 1949, 311, 9526, 449, 2204, 4595, 315, 41776, 323, 1505, 701, 7075, 0]
