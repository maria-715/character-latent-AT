9, 1063, 315, 279, 2768, 1473, 12, 578, 5165, 10181, 315, 35653, 323, 12053, 320, 45, 3931, 8, 5825, 17959, 323, 10886, 389, 26542, 323, 828, 4868, 13, 482, 578, 5377, 5000, 7473, 8398, 5907, 320, 3387, 66204, 8, 5825, 16195, 5070, 389, 3566, 3851, 4868, 11, 2737, 26542, 13, 482, 578, 35269, 58418, 5114, 320, 55765, 8, 5825, 5070, 389, 7528, 12625, 11, 2737, 26542, 13, 482, 63155, 3241, 12850, 3629, 3493, 16627, 5070, 323, 44912, 389, 26542, 323, 26542, 3241, 13, 358, 3987, 420, 8779, 0, 6914, 757, 1440, 422, 499, 617, 904, 1023, 4860, 13, 128006, 882, 128007, 271, 12947, 369, 279, 19075, 389, 5070, 311, 4048, 810, 922, 26542, 323, 828, 4868, 13, 3053, 499, 7079, 904, 2930, 14307, 477, 44912, 389, 1521, 13650, 430, 499, 1781, 527, 8104, 11190, 30, 128006, 78191, 128007, 271, 40914, 0, 5810, 527, 1063, 2930, 14307, 323, 44912, 389, 26542, 323, 828, 4868, 430, 358, 1781, 527, 8104, 11190, 1473, 16, 13, 38547, 5814, 358, 555, 31788, 3907, 389, 6377, 805, 64, 482, 1115, 374, 264, 1949, 2930, 3388, 430, 14861, 279, 16565, 315, 14774, 2508, 2737, 26542, 11, 90474, 11, 323, 90229, 26249, 382, 17, 13, 34711, 17476, 369, 8184, 555, 279, 3907, 315, 15745, 389, 6377, 805, 64, 482, 1115, 374, 264, 16195, 3388, 389, 62542, 430, 14861, 13650, 1778, 439, 26542, 11, 828, 9313, 11, 323, 4009, 4868, 382, 18, 13, 66736, 38547, 5814, 304, 13325, 555, 38547, 5814, 4340, 482, 1115, 374, 264, 1949, 2930, 22237, 430, 33992, 1268, 311, 1005, 87937, 304, 13325, 11, 2737, 55443, 323, 97929, 26542, 11, 73455, 11, 323, 7528, 33728, 382, 19, 13, 29438, 311, 38547, 5814, 323, 1202, 32625, 555, 70514, 423, 491, 83, 389, 1608, 55, 482, 1115, 374, 459, 11084, 3388, 430, 14861, 279, 16565, 323, 8522, 315, 87937, 2737, 26542, 11, 7528, 33728, 11, 323, 41577, 10758, 32885, 382, 20, 13, 578, 63155, 51435, 17026, 555, 15161, 32705, 482, 1115, 374, 264, 1949, 2930, 22237, 430, 14861, 279, 32874, 315, 26542, 323, 1268, 311, 1005, 433, 311, 30725, 828, 304, 25032, 323, 520, 2800, 382, 40, 3987, 499, 1505, 1521, 5070, 11190, 0, 6914, 757, 1440, 422, 499, 617, 904, 4726, 4860, 13]
