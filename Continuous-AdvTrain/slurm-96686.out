, 12205, 323, 1579, 8396, 382, 24901, 11, 279, 3363, 596, 8752, 574, 1101, 75720, 291, 555, 279, 6650, 315, 19647, 1778, 439, 94082, 323, 8448, 24177, 11, 439, 1664, 439, 279, 53414, 32083, 5064, 430, 8040, 2212, 279, 480, 91354, 13381, 21342, 13, 32255, 11, 1521, 9547, 9087, 311, 1304, 59900, 832, 315, 279, 1455, 77014, 323, 71407, 9919, 304, 5270, 2391, 279, 3389, 220, 777, 339, 323, 4216, 220, 508, 339, 24552, 13, 128006, 882, 128007, 271, 2181, 10578, 1093, 59900, 574, 264, 2216, 13548, 2035, 311, 387, 2391, 279, 480, 91354, 13381, 0, 14910, 904, 11495, 1274, 1650, 433, 2162, 30, 128006, 78191, 128007, 271, 9642, 11, 59900, 574, 2162, 311, 3892, 11495, 1274, 2391, 279, 480, 91354, 13381, 13, 9176, 315, 5270, 596, 93118, 8689, 11, 1778, 439, 279, 59142, 49938, 2641, 11, 20717, 1105, 11, 323, 79160, 598, 11, 5918, 43828, 7474, 10632, 304, 59900, 13, 7089, 1664, 22015, 11062, 5343, 3229, 3279, 411, 1254, 80596, 11, 889, 6267, 3892, 32963, 743, 304, 59900, 11, 323, 4900, 72845, 423, 13, 89181, 11, 889, 1047, 264, 7474, 2162, 1070, 2391, 813, 32858, 382, 644, 5369, 311, 279, 3363, 596, 28994, 11062, 11, 59900, 574, 1101, 264, 5526, 9284, 369, 40501, 323, 13820, 315, 279, 892, 13, 82461, 323, 91128, 1778, 439, 14693, 301, 31858, 6518, 323, 445, 65821, 25953, 11, 323, 13820, 1778, 439, 3842, 5034, 435, 2812, 323, 921, 35376, 43122, 309, 682, 7543, 892, 304, 59900, 2391, 279, 480, 91354, 13381, 13, 578, 3363, 596, 3674, 6237, 574, 28812, 11, 323, 1690, 11495, 1274, 18677, 279, 80234, 9875, 323, 4455, 430, 1051, 5762, 1070, 13, 128006, 882, 128007, 271, 2181, 596, 2216, 8056, 311, 1781, 922, 682, 279, 3925, 323, 80049, 315, 59900, 2391, 279, 480, 91354, 13381, 13, 3234, 499, 1440, 422, 904, 315, 1884, 6800, 84075, 505, 430, 892, 527, 2103, 2212, 3432, 30, 128006, 78191, 128007, 271, 9642, 11, 1690, 315, 279, 6800, 84075, 323, 50334, 919, 5918, 2391, 279, 480, 91354, 13381, 304, 59900, 527, 2103, 11509, 3432, 323, 617, 1027, 34683, 439, 31070, 39591, 477, 51677, 13, 3861, 315, 279, 1455, 11495, 374, 578, 15996, 388, 11, 902, 574, 5918, 555, 279, 84126, 3070, 304, 279, 3389, 220, 5245, 15, 82, 323, 374, 1457, 1825, 311, 279, 586, 439, 961, 315, 279, 92041, 13581, 315, 59900, 6406, 13, 7089, 28289, 50334, 919, 2997, 73621, 4783, 11, 902, 574, 2500, 84126, 3424, 11, 323, 58421, 5236, 11, 902, 574, 2162, 311, 65589, 676, 323, 58738, 897, 380, 25225, 285, 27453, 382, 3947, 527, 1101, 3892, 1023, 34683, 61024, 11, 27943, 11, 323, 13970, 6732, 430, 527, 5922, 17136, 304, 59900, 13, 1789, 3187, 11, 48952, 12839, 374, 264, 62081, 38464, 9025, 430, 57196, 3235, 279, 70027, 323, 5825, 6366, 6325, 315, 279, 50334, 919, 323, 279, 18435, 13, 578, 7327, 58251, 11166, 315, 39627, 374, 2500, 5526, 33464, 11, 902, 71849, 279, 3925, 315, 32515, 323, 49593, 279, 10775, 596, 12474, 34838, 13, 2052, 304, 682, 11, 59900, 8625, 264, 27387, 2035, 311, 13488, 11, 449, 1202, 9257, 3925, 323, 6366, 18112, 10209, 264, 40942, 1139, 264, 555, 46696, 11639, 315, 3778, 8396, 13]
