440, 1148, 1364, 4460, 323, 10371, 369, 1520, 994, 1364, 2631, 433, 13, 3005, 1766, 430, 279, 27460, 430, 1364, 6222, 449, 1124, 1051, 1524, 16643, 1109, 1603, 11, 41976, 304, 48451, 11, 30481, 323, 3021, 13, 11205, 15375, 402, 4776, 1862, 323, 9546, 1051, 42045, 304, 10695, 10455, 311, 21546, 1077, 38384, 11879, 13, 2435, 3984, 1077, 449, 264, 5647, 315, 6981, 11, 3987, 323, 4029, 430, 1903, 1077, 2733, 2753, 7636, 304, 1077, 6784, 13, 763, 279, 842, 11, 10455, 9687, 430, 38384, 374, 539, 264, 11879, 430, 832, 649, 733, 1555, 7636, 13, 3161, 279, 1862, 315, 1077, 4885, 323, 3070, 11, 1364, 574, 3025, 311, 1505, 1077, 1648, 1555, 279, 27394, 323, 34044, 1139, 279, 3177, 13, 1628, 369, 430, 11, 1364, 1053, 387, 16058, 26259, 13]
