, 21316, 532, 706, 8522, 304, 5370, 5151, 1778, 439, 19463, 11, 13443, 11, 323, 3698, 17720, 1233, 13, 1102, 374, 17037, 1511, 304, 38696, 311, 1797, 279, 1396, 315, 73049, 11, 28559, 323, 5627, 304, 902, 264, 743, 315, 6302, 649, 387, 28902, 13, 1102, 374, 1101, 1511, 304, 279, 7419, 315, 1063, 37072, 5865, 11, 1778, 439, 279, 22350, 734, 13]
