6, 374, 8464, 311, 701, 7057, 596, 9904, 11, 2533, 279, 3813, 323, 55402, 315, 5110, 649, 13592, 1990, 22100, 13, 128006, 882, 128007, 271, 6854, 499, 3493, 757, 449, 264, 2723, 311, 279, 9904, 369, 856, 7057, 30, 128006, 78191, 128007, 271, 40, 1541, 956, 617, 2680, 311, 701, 3637, 596, 7057, 2038, 13, 4452, 11, 499, 649, 6118, 1505, 279, 9904, 369, 701, 7057, 555, 2133, 311, 279, 8221, 1463, 7057, 3637, 11, 9455, 701, 7057, 323, 18965, 389, 279, 364, 24249, 6, 2723, 7559, 304, 279, 5740, 1314, 9309, 315, 279, 2199, 13, 39578, 11, 499, 649, 656, 264, 11819, 2778, 369, 279, 836, 315, 701, 7057, 8272, 555, 364, 77403, 6, 477, 364, 882, 8641, 4527, 128006, 882, 128007, 271, 6854, 499, 7838, 422, 420, 4668, 1101, 4375, 369, 279, 17697, 14355, 3857, 315, 856, 7057, 30, 128006, 78191, 128007, 271, 791, 14580, 2217, 20118, 4668, 1253, 477, 1253, 539, 990, 369, 701, 17697, 14355, 3857, 11, 11911, 389, 279, 6683, 315, 701, 7057, 13, 4427, 22100, 2997, 420, 4668, 304, 279, 17697, 14355, 3857, 555, 1670, 11, 1418, 3885, 1253, 1397, 5217, 49141, 13, 2057, 1817, 422, 420, 4668, 374, 2561, 369, 279, 17697, 14355, 3857, 315, 701, 7057, 11, 1833, 1521, 7504, 1473, 16, 13, 6122, 311, 279, 17697, 14355, 3857, 1405, 499, 1053, 1093, 311, 7431, 279, 4668, 13, 220, 17, 13, 9369, 389, 279, 17697, 14355, 5110, 4706, 320, 55827, 4706, 8, 323, 1427, 369, 364, 1945, 3113, 6, 477, 364, 1945, 20118, 4527, 220, 18, 13, 1442, 2561, 11, 3373, 364, 7968, 14580, 2217, 389, 20118, 4527, 220, 19, 13, 10467, 279, 4442, 13, 1442, 420, 3072, 374, 539, 2561, 304, 701, 17697, 14355, 3857, 5110, 11, 499, 1253, 1205, 311, 5662, 704, 311, 701, 7057, 16131, 369, 13291, 449, 2587, 4954, 701, 17697, 14355, 3857, 311, 2997, 420, 4668, 13]
