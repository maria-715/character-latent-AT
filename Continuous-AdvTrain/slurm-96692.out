369, 3932, 311, 8891, 323, 7417, 872, 12459, 26870, 11, 6522, 311, 2731, 2890, 323, 1664, 33851, 13, 128006, 882, 128007, 271, 6854, 499, 3041, 757, 1063, 810, 3649, 389, 1268, 279, 35649, 19075, 4668, 1053, 990, 30, 128006, 78191, 128007, 271, 40914, 0, 2100, 11, 279, 35649, 19075, 4668, 1053, 990, 555, 4737, 1139, 2759, 279, 1217, 596, 9021, 11, 19882, 11, 323, 2890, 4787, 13, 1789, 3187, 11, 422, 264, 1217, 374, 4560, 311, 9229, 4785, 11, 279, 917, 2643, 7079, 3428, 49236, 30303, 21644, 323, 43402, 13, 2057, 636, 3940, 11, 279, 1217, 1053, 1205, 311, 743, 709, 264, 5643, 449, 872, 4443, 3649, 11, 1778, 439, 2673, 11, 4785, 11, 4325, 11, 323, 7106, 5820, 2237, 13, 20817, 389, 420, 2038, 11, 279, 917, 1053, 11294, 279, 11349, 7446, 52703, 23730, 369, 279, 1217, 13, 578, 1217, 649, 1243, 1988, 872, 34625, 19882, 323, 2890, 4787, 11, 1778, 439, 1694, 46482, 11, 3515, 272, 95705, 8624, 11, 477, 1694, 51644, 974, 72729, 519, 13, 578, 917, 1053, 1935, 1139, 2759, 1521, 17294, 323, 1304, 35649, 19075, 28178, 13, 578, 917, 1436, 1101, 4284, 25795, 94750, 477, 13651, 12562, 3196, 389, 279, 1217, 596, 9021, 13, 1789, 3187, 11, 422, 279, 1217, 374, 4560, 311, 8108, 872, 13465, 23730, 11, 279, 917, 2643, 4284, 1701, 264, 5933, 10437, 804, 1093, 26828, 477, 18189, 279, 3392, 315, 13465, 304, 264, 11363, 13, 28993, 11, 279, 35649, 19075, 4668, 1053, 387, 264, 15525, 5507, 369, 3932, 889, 1390, 311, 1304, 9498, 12459, 264, 961, 315, 872, 19433, 13]
